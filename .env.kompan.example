# Copy to .env.kompan (next to docker-compose.yml) on the AP computer and fill in.
# .env.kompan is never committed (.gitignore). Only the ap-gra-kompan service reads it.
# A separate key (ap-kompan), so the cost of Kompan is visible apart from the games.
ANTHROPIC_API_KEY=
# Optional (kompan/app.py):
# AP_KOMPAN_MODEL=claude-opus-5-5
# AP_KOMPAN_EFFORT=medium
# AP_KOMPAN_LIMIT_USD=5   # daily limit
